# Un token per ogni bot, creati con @BotFather
MAX_TOKEN=123456:token-di-max
VIVI_TOKEN=123456:token-di-vivi
# JESS_TOKEN=   (in arrivo)

# Il tuo user ID Telegram (@userinfobot). Più ID separati da virgola.
ALLOWED_USERS=123456789

# Cartella del PC accessibile ai bot
FILES_ROOT=C:\Users\TuoNome

# Opzionale: per chattare liberamente con Max (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Notion (Max sincronizza to-do, note, promemoria e diario)
# Token da https://www.notion.so/profile/integrations  → "Nuova integrazione"
NOTION_TOKEN=
# Link (o ID) della pagina Notion in cui Max creerà il suo database
NOTION_PAGE_ID=
